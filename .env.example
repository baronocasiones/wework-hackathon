# App and local persistence
APP_URL=http://localhost:8000
# One-time key for creating the first owner account at /register. Once registered, sign in with the account password.
STUDIO_PASSWORD=
DATABASE_PATH=./data/studio.sqlite
UPLOAD_DIR=./public/uploads

# Gemini suggests titles, captions, and subtitles. It is not used for image or video generation.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Cloudflare Workers AI FLUX.1 Schnell creates backgrounds for template Publication Materials,
# fallback artwork and fallback motion posters (when fal is unavailable or ARTWORK_TEXT_MODE=overlay).
# Template text remains editable locally.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_STEPS=8
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Runtime agent loop critiques generated images/videos with Gemini vision and regenerates up to N times.
AGENT_ENABLED=true
AGENT_SCORE_THRESHOLD=70
AGENT_DAILY_CAP=50
OVERLAY_QA_ENABLED=videos
GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# fal powers two tracks. Artwork/motion poster fallback uses Ideogram poster art
# (fal-ai/ideogram/v3): headline, supporting line, and CTA are rendered inside the
# artwork (DESIGN style, portrait 4:3). FAL_IDEOGRAM_SPEED: TURBO | BALANCED | QUALITY.
# ARTWORK_TEXT_MODE=overlay forces the Cloudflare + editable on-media captions path.
# Motion video runs xAI Grok Imagine Video 1.5 Lite (text-to-video) — the cheapest
# fal option under the demo budget; text rendered by the video is best-effort and may
# mis-render. If Grok fails or FAL_KEY is missing, video falls back to an Ideogram
# motion poster (Ken Burns over a still, ~$0.06).
FAL_KEY=
FAL_IDEOGRAM_SPEED=BALANCED
ARTWORK_TEXT_MODE=ideogram
# Default 5-second 720p vertical Grok clip; VIDEO also drives the Ken Burns fallback duration (1–15s).
FAL_VIDEO_DURATION=5
FAL_VIDEO_RESOLUTION=720p
# Optional royalty-free ambient track muxed into Grok/Ken Burns videos when set.
FAL_VIDEO_AUDIO_TRACK=
# Optional font file for FFmpeg drawtext in template images.
FFMPEG_FONT_PATH=

# Cloudinary signed server-side uploads for public HTTPS media URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Facebook and Instagram use local simulation by default, with no Meta requests.
# Only META_PUBLISH_MODE=live deliberately enables real publishing; live mode also
# needs all three credentials below, public Cloudinary media, and a public APP_URL.
# Leave these credential fields blank for the hackathon simulation.
META_PUBLISH_MODE=simulated
META_GRAPH_VERSION=v23.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# Google OAuth for YouTube. Configure this exact redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback
GOOGLE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# App and local persistence
APP_URL=http://localhost:8000
STUDIO_USERNAME=operator
STUDIO_PASSWORD=
DATABASE_PATH=./data/studio.sqlite
UPLOAD_DIR=./public/uploads

# Gemini is tried first when both providers are configured. Switch to openai later if preferred.
# Image and native video generation require a paid Gemini API tier.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash

# OpenAI is an optional fallback. All values stay on the server.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare

# Cloudinary signed server-side uploads for public HTTPS media URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta Graph API. Use a Page access token with these permissions.
META_GRAPH_VERSION=v23.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# Google OAuth for YouTube. Configure this exact redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback
GOOGLE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
